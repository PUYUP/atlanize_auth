# ---- Server ----
NODE_ENV=production
PORT=3000

# ---- Better Auth ----
# Generate with: npm run auth:secret   (wraps `npx auth secret`)
BETTER_AUTH_SECRET=
# Public URL this API is served from. Its origin is trusted automatically.
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated list of frontend origins allowed to call this API
# (used for both CORS and Better Auth's own origin check).
TRUSTED_ORIGINS=http://localhost:5173

# ---- Database (Supabase PostgreSQL) ----
# Supabase Dashboard > Project Settings > Database > Connection string.
# Recommended for a long-lived container: the "Session pooler" string
# (port 5432) — it's IPv4-safe and supports prepared statements.
#   postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres
# Use the "Transaction pooler" (port 6543) instead only if you run many
# horizontally-scaled replicas of this API.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_POOL_MAX=10
# Set to "disable" only for local Postgres without SSL.
DATABASE_SSL=require

# ---- Google OAuth (optional — leave blank to disable) ----
# Redirect URI to register in Google Cloud Console:
#   {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- GitHub OAuth (optional — leave blank to disable) ----
# Redirect URI to register in your GitHub OAuth App:
#   {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
